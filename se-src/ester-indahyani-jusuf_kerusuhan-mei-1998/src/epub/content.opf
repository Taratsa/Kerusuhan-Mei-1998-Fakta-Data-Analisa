		<dc:title id="title">Kerusuhan Mei 1998</dc:title>
		<meta property="file-as" refines="#title">Kerusuhan Mei 1998</meta>
		<meta property="title-type" refines="#title">main</meta>
		<dc:title id="subtitle">Fakta, Data &amp; Analisa: Mengungkap Kerusuhan Mei 1998 Sebagai Kejahatan Terhadap Kemanusiaan</dc:title>
		<meta property="file-as" refines="#subtitle">Fakta, Data &amp; Analisa: Mengungkap Kerusuhan Mei 1998 Sebagai Kejahatan Terhadap Kemanusiaan</meta>
		<meta property="title-type" refines="#subtitle">subtitle</meta>
		<dc:title id="fulltitle">Kerusuhan Mei 1998: Fakta, Data &amp; Analisa: Mengungkap Kerusuhan Mei 1998 Sebagai Kejahatan Terhadap Kemanusiaan</dc:title>
		<meta property="file-as" refines="#fulltitle">Kerusuhan Mei 1998: Fakta, Data &amp; Analisa: Mengungkap Kerusuhan Mei 1998 Sebagai Kejahatan Terhadap Kemanusiaan</meta>
		<meta property="title-type" refines="#fulltitle">expanded</meta>
		<dc:subject id="subject-1">Riots--Indonesia</dc:subject>
		<dc:subject id="subject-2">Chinese--Indonesia</dc:subject>
